diff --git a/tests/unit/kernel/video_mode_test.cpp b/tests/unit/kernel/video_mode_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/kernel/video_mode_test.cpp
@@ -0,0 +1,52 @@
+#include <array>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xboxkrnl/video.h>
+
+namespace {
+
+class VideoFlagScope {
+ public:
+  VideoFlagScope() { Reset(); }
+  ~VideoFlagScope() { Reset(); }
+
+ private:
+  static void Reset() {
+    for (const char* name :
+         std::array{"window_width", "window_height", "video_mode_width", "video_mode_height"}) {
+      rex::cvar::ResetToDefault(name);
+    }
+    rex::cvar::ClearPendingRestartFlags();
+  }
+};
+
+void CheckVideoMode(uint32_t width, uint32_t height) {
+  rex::system::X_VIDEO_MODE mode{};
+  rex::kernel::xboxkrnl::VdQueryVideoMode(&mode);
+  CHECK(static_cast<uint32_t>(mode.display_width) == width);
+  CHECK(static_cast<uint32_t>(mode.display_height) == height);
+}
+
+}  // namespace
+
+TEST_CASE("Explicit guest video mode takes precedence over window dimensions", "[kernel][video]") {
+  VideoFlagScope flags;
+  REQUIRE(rex::cvar::SetFlagFromCommandLine("window_width", "1600"));
+  REQUIRE(rex::cvar::SetFlagFromCommandLine("window_height", "900"));
+
+  SECTION("Unset video dimensions inherit the requested window dimensions") {
+    CheckVideoMode(1600, 900);
+  }
+  SECTION("Explicit compiled-default dimensions override the window") {
+    REQUIRE(rex::cvar::SetFlagFromCommandLine("video_mode_width", "1280"));
+    REQUIRE(rex::cvar::SetFlagFromCommandLine("video_mode_height", "720"));
+    CheckVideoMode(1280, 720);
+  }
+  SECTION("Explicit nondefault dimensions override the window") {
+    REQUIRE(rex::cvar::SetFlagFromCommandLine("video_mode_width", "1920"));
+    REQUIRE(rex::cvar::SetFlagFromCommandLine("video_mode_height", "1080"));
+    CheckVideoMode(1920, 1080);
+  }
+}
