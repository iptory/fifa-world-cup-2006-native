+
 #include <cstdint>
 #include <cstring>
 
@@ -49,6 +51,48 @@ constexpr size_t kMaxHandlerCount = 8;
 // Executed in order.
 std::pair<ExceptionHandler::Handler, void*> handlers_[kMaxHandlerCount];
 
+static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
+                                     void* signal_context);
+
+static void ForwardUnhandledFault(int signal_number, siginfo_t* signal_info,
+                                  void* signal_context) {
+  struct sigaction& saved = signal_number == SIGILL ? original_sigill_handler_
+#if REX_PLATFORM_MAC
+                           : signal_number == SIGBUS ? original_sigbus_handler_
+#endif
+                                                     : original_sigsegv_handler_;
+  const struct sigaction previous = saved;
+  if (previous.sa_handler == SIG_IGN && signal_info->si_code <= 0) return;
+  if (previous.sa_handler != SIG_DFL && previous.sa_handler != SIG_IGN &&
+      (!(previous.sa_flags & SA_SIGINFO) ||
+       previous.sa_sigaction != ExceptionHandlerCallback)) {
+    if (previous.sa_flags & SA_RESETHAND) {
+      saved = {};
+      saved.sa_handler = SIG_DFL;
+    }
+    // Recreate the prior handler's mask, including SA_NODEFER used by POSIX SEH.
+    sigset_t mask = reinterpret_cast<ucontext_t*>(signal_context)->uc_sigmask;
+    for (int sig = 1; sig < NSIG; ++sig) {
+      if (sigismember(&previous.sa_mask, sig) == 1) sigaddset(&mask, sig);
+    }
+    if (!(previous.sa_flags & SA_NODEFER)) sigaddset(&mask, signal_number);
+    sigprocmask(SIG_SETMASK, &mask, nullptr);
+    if (previous.sa_flags & SA_SIGINFO) {
+      previous.sa_sigaction(signal_number, signal_info, signal_context);
+    } else {
+      previous.sa_handler(signal_number);
+    }
+    return;
+  }
+  // A synchronous fault cannot be ignored: let the original signal terminate it.
+  struct sigaction action {};
+  action.sa_handler = SIG_DFL;
+  sigemptyset(&action.sa_mask);
+  if (sigaction(signal_number, &action, nullptr) != 0 || raise(signal_number) != 0) {
+    std::abort();
+  }
+}
+
 static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
                                      void* signal_context) {
 #if REX_PLATFORM_MAC
@@ -417,6 +461,9 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       return;
     }
   }
+  // No handler claimed the fault: forward to the previously installed
+  // disposition instead of returning to the faulting instruction.
+  ForwardUnhandledFault(signal_number, signal_info, signal_context);
 }
 
