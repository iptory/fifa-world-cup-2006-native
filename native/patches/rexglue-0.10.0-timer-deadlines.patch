@@ -0,0 +1,37 @@
+// Copyright (c) 2026 Contributors. BSD-3-Clause; see LICENSE.
+#include <chrono>
+#include <initializer_list>
+#include <catch2/catch_test_macros.hpp>
+#include <rex/thread.h>
+
+#if !REX_PLATFORM_WIN32
+using namespace std::chrono_literals;
+using rex::thread::Event;
+using rex::thread::Timer;
+using rex::thread::Wait;
+using rex::thread::WaitResult;
+using Clock = Timer::WClock_;
+
+TEST_CASE("Past absolute timers expire and auto-reset", "[timer-deadline]") {
+  for (const auto due :
+       {Clock::time_point{}, Clock::now() - std::chrono::duration_cast<Clock::duration>(1s)}) {
+    auto completed = Event::CreateManualResetEvent(false);
+    auto timer = Timer::CreateSynchronizationTimer();
+    REQUIRE(completed);
+    REQUIRE(timer);
+    REQUIRE(timer->SetOnceAt(due, [&] { completed->Set(); }));
+    REQUIRE(Wait(timer.get(), false, 2s) == WaitResult::kSuccess);
+    REQUIRE(Wait(completed.get(), false, 2s) == WaitResult::kSuccess);
+    CHECK(Wait(timer.get(), false, 0ms) == WaitResult::kTimeout);
+    REQUIRE(timer->Cancel());
+  }
+}
+
+TEST_CASE("Far-future absolute timers do not expire immediately", "[timer-deadline]") {
+  auto timer = Timer::CreateSynchronizationTimer();
+  REQUIRE(timer);
+  REQUIRE(timer->SetOnceAt(Clock::time_point::max()));
+  CHECK(Wait(timer.get(), false, 25ms) == WaitResult::kTimeout);
+  REQUIRE(timer->Cancel());
+}
+#endif
