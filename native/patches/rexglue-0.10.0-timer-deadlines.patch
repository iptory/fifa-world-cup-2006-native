   using WClock_ = Timer::WClock_;
   using GClock_ = Timer::GClock_;
 
+  static GClock_::time_point ToSteadyDeadline(WClock_::time_point due_time) {
+    const auto steady_now = GClock_::now();
+    const auto wall_now = WClock_::now();
+    // FILETIME can precede steady_clock's range; bound the delta before narrowing.
+    if (due_time <= wall_now) {
+      return steady_now;
+    }
+    const auto remaining = due_time - wall_now;
+    const auto available = GClock_::time_point::max() - steady_now;
+    if (remaining >= std::chrono::duration_cast<WClock_::duration>(available)) {
+      return GClock_::time_point::max();
+    }
+    return steady_now + std::chrono::duration_cast<GClock_::duration>(remaining);
+  }
+
  public:
   explicit PosixTimer(bool manual_reset) : PosixConditionHandle(manual_reset) {}
   ~PosixTimer() override = default;
